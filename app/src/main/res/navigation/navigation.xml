<?xml version="1.0" encoding="utf-8"?>

<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_graph"
    app:startDestination="@+id/events_fragment">

    <include app:graph="@navigation/metadata"/>

    <fragment android:id="@+id/wf_female_fragment"
        android:name="org.phenoapps.intercross.fragments.wish_factory.FemaleChoiceFragment">
        <action android:id="@+id/action_from_females_to_males_fragment"
            app:destination="@+id/wf_male_fragment"
            app:launchSingleTop="true">
            <argument android:name="id"
                app:argType="string"/>
            <argument android:name="name"
                app:argType="string"/>
        </action>
        <action android:id="@+id/action_from_females_to_barcode_scan_fragment"
            app:destination="@id/wf_barcode_scan_fragment"
            app:popUpTo="@id/wf_female_fragment"
            app:launchSingleTop="true"/>
    </fragment>

    <fragment android:id="@+id/wf_male_fragment"
        android:name="org.phenoapps.intercross.fragments.wish_factory.MaleChoiceFragment">
        <action android:id="@+id/action_from_males_to_types_fragment"
            app:destination="@+id/wf_type_fragment"
            app:popUpTo="@id/wf_female_fragment"
            app:launchSingleTop="true">
            <argument android:name="femaleId"
                app:argType="string"/>
            <argument android:name="femaleName"
                app:argType="string"/>
            <argument android:name="maleId"
                app:argType="string"
                android:defaultValue="-1"/>
            <argument android:name="maleName"
                app:argType="string"
                android:defaultValue="blank"/>
        </action>
        <action android:id="@+id/action_from_males_to_barcode_scan_fragment"
            app:destination="@id/wf_barcode_scan_fragment"
            app:popUpTo="@id/wf_male_fragment"
            app:launchSingleTop="true">
            <argument android:name="femaleId"
                app:argType="string"/>
            <argument android:name="femaleName"
                app:argType="string"/>
        </action>
    </fragment>

    <fragment android:id="@+id/wf_type_fragment"
        android:name="org.phenoapps.intercross.fragments.wish_factory.TypeChoiceFragment">
        <action
            android:id="@+id/action_from_types_to_values_fragment"
            app:destination="@id/wf_values_fragment"
            app:popUpTo="@id/wf_male_fragment"
            app:launchSingleTop="true" >
            <argument android:name="femaleId"
                app:argType="string"/>
            <argument android:name="femaleName"
                app:argType="string"/>
            <argument android:name="maleId"
                app:argType="string"/>
            <argument android:name="maleName"
                app:argType="string"/>
            <argument android:name="typeName"
                app:argType="string"/>
        </action>
        <action android:id="@+id/action_from_types_to_wishlist_back"
            app:popUpTo="@id/events_fragment"
            app:launchSingleTop="true"
            app:destination="@id/cross_tracker_fragment"/>
    </fragment>

    <fragment android:id="@+id/wf_values_fragment"
        android:name="org.phenoapps.intercross.fragments.wish_factory.ValuesChoiceFragment">
        <action
            android:id="@+id/action_from_values_to_summary_fragment"
            app:destination="@id/wf_summary_fragment"
            app:popUpTo="@id/wf_type_fragment"
            app:launchSingleTop="true" >
            <argument android:name="femaleId"
                app:argType="string"/>
            <argument android:name="femaleName"
                app:argType="string"/>
            <argument android:name="maleId"
                app:argType="string"/>
            <argument android:name="maleName"
                app:argType="string"/>
            <argument android:name="typeName"
                app:argType="string"/>
            <argument android:name="min"
                app:argType="integer"
                android:defaultValue="1"/>
            <argument android:name="max"
                app:argType="integer"
                android:defaultValue="10"/>
        </action>
    </fragment>

    <fragment android:id="@+id/wf_summary_fragment"
        android:name="org.phenoapps.intercross.fragments.wish_factory.SummaryFragment">
        <action android:id="@+id/action_from_wf_to_wishlist_back"
            app:popUpTo="@id/events_fragment"
            app:launchSingleTop="true"
            app:destination="@id/cross_tracker_fragment"/>
    </fragment>

    <fragment
        android:id="@+id/wf_barcode_scan_fragment"
        android:name="org.phenoapps.intercross.fragments.wish_factory.BarcodeScanFragment"
        android:label="@string/barcode_scan_label">
        <action android:id="@+id/action_to_females_fragment_from_scan"
            app:destination="@id/wf_female_fragment"
            app:popUpTo="@id/wf_female_fragment">
            <argument android:name="barcode" app:argType="string"/>
        </action>
        <action android:id="@+id/action_to_males_fragment_from_scan"
            app:popUpTo="@id/wf_male_fragment"
            app:destination="@id/wf_male_fragment">
            <argument android:name="barcode" app:argType="string"/>
            <argument android:name="id" app:argType="string"/>
            <argument android:name="name" app:argType="string"/>
        </action>
    </fragment>

    <!-- Events Fragment is the main entry fragment that shows the entire crossing table -->
    <fragment android:id="@+id/events_fragment"
        android:name="org.phenoapps.intercross.fragments.EventsFragment"
        android:label="@string/events_fragment_label"
        tools:layout="@layout/fragment_events">

        <action android:id="@+id/action_to_barcode_scan_fragment"
            app:destination="@id/barcode_scan_fragment">
            <argument
                android:name="mode"
                app:argType="integer"
                android:defaultValue="0"/>
        </action>
        <action android:id="@+id/action_to_event_fragment"
            app:destination="@id/event_fragment"
            app:popUpTo="@id/events_fragment">
        </action>
        <action android:id="@+id/action_to_cross_tracker_fragment"
            app:destination="@+id/cross_tracker_fragment"
            app:popUpTo="@id/events_fragment">
        </action>
        <action android:id="@+id/action_to_wishlist_fragment"
            app:destination="@+id/wishlist_fragment"
            app:popUpTo="@id/events_fragment">
        </action>
        <action android:id="@+id/action_to_parents_fragment"
            app:destination="@+id/parents_fragment"
            app:popUpTo="@id/events_fragment"/>
        <action android:id="@+id/action_to_crossblock"
            app:destination="@+id/crossblock_fragment"
            app:popUpTo="@id/events_fragment"/>
        <action android:id="@+id/action_to_summary"
            app:destination="@+id/summary_fragment"
            app:popUpTo="@id/events_fragment"/>
        <action android:id="@+id/action_to_about"
            app:destination="@+id/about_fragment"
            app:popUpTo="@id/events_fragment"/>
        <action
            android:id="@+id/action_to_parents_import"
            app:destination="@+id/brapi_parents_import_fragment"
            app:popUpTo="@id/events_fragment"/>
        <action android:id="@+id/action_from_events_to_preferences"
            app:destination="@+id/preferences"
            app:popUpTo="@id/events_fragment">
            <argument
                android:name="PERSON_UPDATE"
                app:argType="boolean"
                android:defaultValue="false" />
            <argument
                android:name="MODIFY_PROFILE"
                app:argType="boolean"
                android:defaultValue="false" />
        </action>
        <action
            android:id="@+id/action_to_brapi_export"
            app:destination="@+id/brapi_export_fragment"
            app:popUpTo="@id/events_fragment"/>
        <action
            android:id="@+id/action_from_settings_to_naming_workflow_fragment"
            app:destination="@id/behavior_preferences_fragment"
            app:popUpTo="@id/events_fragment" />
    </fragment>

    <fragment
        android:id="@+id/brapi_export_summary_fragment"
        android:name="org.phenoapps.intercross.fragments.brapi.BrapiExportSummaryFragment"
        android:label="@string/brapi_export_summary_title">
        <argument
            android:name="crossingProjectDbId"
            app:argType="string" />
        <argument
            android:name="crossingProjectName"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="crossingProjectDescription"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="programName"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="commonCropName"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="parentCount"
            app:argType="integer"
            android:defaultValue="0" />
    </fragment>

    <fragment
        android:id="@+id/brapi_cross_project_fragment"
        android:name="org.phenoapps.intercross.fragments.brapi.BrapiCrossProjectFragment"
        android:label="@string/home_brapi_import">
        <!-- 0 - import wishlist, 1 - import parents, 2 - import crosses, 3 - export crosses -->
        <argument
            android:name="mode"
            app:argType="integer"
            android:defaultValue="0" />
        <action
            android:id="@+id/action_brapi_cross_project_import_fragment_to_brapi_planned_crosses_fragment"
            app:destination="@+id/brapi_planned_crosses_fragment" />
        <action
            android:id="@+id/action_brapi_cross_project_import_fragment_to_brapi_potential_parents_fragment"
            app:destination="@+id/brapi_potential_parents_fragment" />
        <action
            android:id="@+id/action_brapi_cross_project_import_fragment_to_brapi_cross_import_fragment"
            app:destination="@+id/brapi_cross_import_fragment" />
        <action
            android:id="@+id/action_to_export_brapi_crosses"
            app:destination="@+id/brapi_export_summary_fragment"/>
    </fragment>

    <fragment
        android:id="@+id/brapi_planned_crosses_fragment"
        android:name="org.phenoapps.intercross.fragments.brapi.BrapiPlannedCrossesFragment"
        android:label="@string/brapi_planned_crosses_title">
        <argument
            android:name="crossingProjectDbId"
            app:argType="string" />
        <argument
            android:name="crossingProjectName"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="crossingProjectDescription"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="programName"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="commonCropName"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="parentCount"
            app:argType="integer"
            android:defaultValue="0" />
    </fragment>

    <fragment
        android:id="@+id/brapi_potential_parents_fragment"
        android:name="org.phenoapps.intercross.fragments.brapi.BrapiPotentialParentsFragment"
        android:label="@string/brapi_potential_parents_title">
        <argument
            android:name="programDbId"
            app:argType="string"/>
        <argument
            android:name="crossingProjectDbId"
            app:argType="string" />
        <argument
            android:name="crossingProjectName"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="crossingProjectDescription"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="programName"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="commonCropName"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="parentCount"
            app:argType="integer"
            android:defaultValue="0" />
        <argument
            android:name="potentialParentsJson"
            app:argType="string[]"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/cross_project_creator_fragment"
        android:name="org.phenoapps.intercross.fragments.CrossProjectCreatorFragment"
        android:label="@string/fragment_cross_project_creator_label"/>

    <fragment
        android:id="@+id/about_fragment"
        android:name="org.phenoapps.intercross.fragments.preferences.AboutFragment"
        android:label="@string/about_title"/>

    <fragment
        android:id="@+id/summary_fragment"
        android:name="org.phenoapps.intercross.fragments.SummaryFragment"
        android:label="@string/summary_title">
        <action android:id="@+id/action_to_cross_tracker"
            app:destination="@id/cross_tracker_fragment"
            app:popUpTo="@id/events_fragment"/>
        <action android:id="@+id/action_to_crossblock"
            app:destination="@id/crossblock_fragment"
            app:popUpTo="@id/summary_fragment"/>
        <action android:id="@+id/action_to_wishlist"
            app:destination="@id/wishlist_fragment"
            app:popUpTo="@id/events_fragment"/>
    </fragment>

    <fragment
        android:id="@+id/barcode_scan_fragment"
        android:name="org.phenoapps.intercross.fragments.BarcodeScanFragment"
        android:label="@string/barcode_scan_label"
        tools:layout="@layout/fragment_barcode_scan">
        <action android:id="@+id/action_to_event_fragment_from_scan"
            app:destination="@id/event_fragment" />
        <action android:id="@+id/action_to_events_from_scan"
            app:destination="@id/events_fragment"/>
        <action android:id="@+id/action_from_scan_to_event_detail"
            app:destination="@+id/event_fragment"
            app:popUpTo="@id/events_fragment"/>
    </fragment>

    <fragment
        android:id="@+id/event_fragment"
        android:name="org.phenoapps.intercross.fragments.EventDetailFragment"
        android:label="@string/event_detail_label"
        tools:layout="@layout/fragment_event_detail">
        <argument
            android:name="eid"
            app:argType="long"/>
        <action android:id="@+id/action_to_event_refresh"
            app:destination="@id/event_fragment"
            app:popUpTo="@id/events_fragment"
            app:launchSingleTop="true"/>
        <action android:id="@+id/action_to_parent_event"
            app:destination="@id/event_fragment"
            app:popUpTo="@id/events_fragment">
            <argument android:name="eid"
                app:argType="long"
                android:defaultValue="-1L"/>
        </action>
        <action android:id="@+id/action_to_events"
            app:destination="@id/events_fragment"
            app:popUpTo="@id/events_fragment">
        </action>
    </fragment>

    <fragment
        android:id="@+id/parents_fragment"
        android:name="org.phenoapps.intercross.fragments.ParentsFragment"
        android:label="@string/parent_label"
        tools:layout="@layout/fragment_parents">

        <action android:id="@+id/action_parents_to_create_event"
            app:destination="@id/parent_creator_fragment"
            app:popUpTo="@id/parents_fragment">
            <argument android:name="mode"
                app:argType="integer"
                android:defaultValue="0"/>
        </action>

        <action android:id="@+id/action_to_summary"
            app:destination="@id/summary_fragment"
            app:popUpTo="@id/parents_fragment">
        </action>
    </fragment>

    <fragment
        android:id="@+id/parent_creator_fragment"
        android:name="org.phenoapps.intercross.fragments.ParentCreatorFragment"
        android:label="@string/parent_creator_label"
        tools:layout="@layout/fragment_parent_creator">

        <argument
            android:name="mode"
            android:defaultValue="0"
            app:argType="integer"/>

        <action
            android:id="@+id/action_return_to_parents_fragment"
            app:destination="@+id/parents_fragment"
            app:popUpTo="@id/events_fragment">
            <argument android:name="malesFirst"
                app:argType="integer"
                android:defaultValue="1"/>
        </action>

        <action
            android:id="@+id/action_to_pollen_manager_fragment"
            app:destination="@+id/pollen_manager_fragment">
            <argument android:name="codeId"
                app:argType="string"
                android:defaultValue=""/>
            <argument android:name="readableName"
                app:argType="string"
                android:defaultValue=""/>
        </action>

    </fragment>

    <fragment
        android:id="@+id/pollen_manager_fragment"
        android:name="org.phenoapps.intercross.fragments.PollenManagerFragment"
        android:label="@string/pollen_manager_label"
        tools:layout="@layout/fragment_pollen_manager">

        <argument android:name="codeId"
            app:argType="string"
            android:defaultValue=""/>
        <argument android:name="readableName"
            app:argType="string"
            android:defaultValue=""/>

        <action
            android:id="@+id/action_return_to_parents_fragment"
            app:destination="@+id/parents_fragment"
            app:popUpTo="@id/events_fragment">
            <argument android:name="malesFirst"
                app:argType="integer"
                android:defaultValue="1"/>
        </action>

        <action
            android:id="@+id/action_return_to_parent_creator_fragment"
            app:destination="@+id/parent_creator_fragment"
            app:popUpTo="@id/parent_creator_fragment">
        </action>

    </fragment>

    <fragment
        android:id="@+id/pattern_fragment"
        android:name="org.phenoapps.intercross.fragments.PatternFragment"
        android:label="@string/patterns_label"
        tools:layout="@layout/fragment_pattern">
    </fragment>

    <fragment
        android:id="@+id/import_zpl_fragment"
        android:name="org.phenoapps.intercross.fragments.ImportZPLFragment"
        android:label="@string/import_zpl_label"
        tools:layout="@layout/fragment_import_zpl">
    </fragment>

    <!-- Summary, Cross Block, and Wishlist Fragment Definitions !-->

    <fragment
        android:id="@+id/search_fragment"
        android:name="org.phenoapps.intercross.fragments.SearchFragment"
        android:label="@string/search_fragment_label"
        tools:layout="@layout/fragment_search">
        <action android:id="@+id/action_from_search_to_event_detail"
            app:destination="@id/event_fragment"
            app:popUpTo="@id/search_fragment"/>
    </fragment>

    <fragment
        android:id="@+id/cross_tracker_fragment"
        android:name="org.phenoapps.intercross.fragments.CrossTrackerFragment"
        android:label="@string/summary_label"
        tools:layout="@layout/fragment_cross_tracker">
        <action android:id="@+id/action_from_cross_tracker_to_search"
            app:destination="@+id/search_fragment"
            app:popUpTo="@id/cross_tracker_fragment"/>
        <action android:id="@+id/action_from_cross_tracker_to_events_list"
            app:destination="@+id/events_fragment"
            app:popUpTo="@id/cross_tracker_fragment">
            <argument app:argType="string"
                android:name="male"/>
            <argument app:argType="string"
                android:name="female"/>
        </action>
        <action android:id="@+id/action_to_wishlist"
            app:destination="@id/wishlist_fragment"
            app:popUpTo="@id/events_fragment"/>
        <action android:id="@+id/action_to_crossblock"
            app:destination="@id/crossblock_fragment"
            app:popUpTo="@id/cross_tracker_fragment"/>
        <action android:id="@+id/action_to_event_detail"
            app:destination="@id/event_fragment"/>
        <action android:id="@+id/action_to_summary"
            app:destination="@+id/summary_fragment"
            app:popUpTo="@id/events_fragment"/>
        <action android:id="@+id/action_from_cross_tracker_to_wish_factory"
            app:destination="@id/wf_female_fragment"
            app:popUpTo="@id/cross_tracker_fragment"/>
        <action android:id="@+id/action_from_cross_tracker_to_brapi_import"
            app:destination="@id/brapi_cross_project_fragment"
            app:popUpTo="@id/cross_tracker_fragment"/>
        <action android:id="@+id/action_from_cross_tracker_to_type_choice"
            app:destination="@id/wf_type_fragment">
            <argument android:name="femaleId" app:argType="string"/>
            <argument android:name="femaleName" app:argType="string"/>
            <argument android:name="maleId" app:argType="string"/>
            <argument android:name="maleName" app:argType="string"/>
        </action>
    </fragment>

    <fragment
        android:id="@+id/crossblock_fragment"
        android:name="org.phenoapps.intercross.fragments.CrossBlockFragment"
        android:label="@string/cross_block_label"
        tools:layout="@layout/fragment_cross_block">

        <action android:id="@+id/action_from_crossblock_to_events_list"
            app:destination="@+id/events_fragment"
            app:popUpTo="@id/crossblock_fragment">
            <argument app:argType="string"
                android:name="male"/>
            <argument app:argType="string"
                android:name="female"/>
        </action>
        <action android:id="@+id/action_to_cross_tracker"
            app:destination="@id/cross_tracker_fragment"
            app:popUpTo="@id/events_fragment"/>
        <action android:id="@+id/action_to_wishlist"
            app:destination="@id/wishlist_fragment"
            app:popUpTo="@id/events_fragment"/>
        <action android:id="@+id/action_to_event_detail"
            app:destination="@+id/event_fragment"
            app:popUpTo="@id/crossblock_fragment"/>
        <action android:id="@+id/action_to_summary"
            app:destination="@+id/summary_fragment"
            app:popUpTo="@id/events_fragment"/>
        <action android:id="@+id/action_from_crossblock_to_wish_factory"
            app:destination="@id/wf_female_fragment"
            app:popUpTo="@id/crossblock_fragment"/>
    </fragment>

    <!-- Global Actions used by Navigation Drawer -->
    <action android:id="@+id/global_action_to_preferences_fragment"
        app:destination="@id/preferences_fragment"
        app:launchSingleTop="true"/>

    <action android:id="@+id/global_action_to_event_detail"
        app:destination="@id/event_fragment"/>

    <action android:id="@+id/global_action_to_events"
        app:destination="@id/events_fragment"
        app:popUpTo="@id/events_fragment"
        app:launchSingleTop="true"/>

    <action android:id="@+id/global_action_to_parents"
        app:destination="@id/parents_fragment"
        app:launchSingleTop="true"
        app:popUpTo="@id/parents_fragment"/>

    <action android:id="@+id/global_action_to_cross_tracker"
        app:destination="@id/cross_tracker_fragment"
        app:popUpTo="@id/cross_tracker_fragment"
        app:launchSingleTop="true"/>

    <action android:id="@+id/global_action_to_summary"
        app:destination="@id/summary_fragment"
        app:popUpTo="@id/summary_fragment"
        app:launchSingleTop="true"/>

    <action android:id="@+id/global_action_to_wishlist_import"
        app:destination="@+id/brapi_cross_project_fragment"
        app:launchSingleTop="true"
        app:popUpTo="@id/cross_tracker_fragment"/>

    <action android:id="@+id/global_action_to_brapi_auth"
        app:destination="@+id/brapi_auth_fragment"
        app:launchSingleTop="true"/>

    <action android:id="@+id/global_action_to_brapi_export"
        app:destination="@+id/brapi_export_fragment"
        app:popUpTo="@id/events_fragment"/>

    <action android:id="@+id/global_action_to_brapi_cross_projects"
        app:destination="@+id/brapi_cross_project_fragment"
        app:launchSingleTop="true"/>

    <fragment
        android:id="@+id/brapi_cross_import_fragment"
        android:name="org.phenoapps.intercross.fragments.brapi.BrapiCrossImportFragment"
        android:label="@string/brapi_crosses_import_title">
        <argument
            android:name="crossingProjectDbId"
            app:argType="string" />
        <argument
            android:name="crossingProjectName"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="crossingProjectDescription"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="programName"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="commonCropName"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="parentCount"
            app:argType="integer"
            android:defaultValue="0" />
    </fragment>

    <fragment
        android:id="@+id/behavior_preferences_fragment"
        android:name="org.phenoapps.intercross.fragments.preferences.BehaviorPreferencesFragment"
        android:label="@string/prefs_behavior_title">
        <action
            android:id="@+id/action_behavior_preferences_fragment_to_pattern_fragment"
            app:destination="@id/pattern_fragment" />
        <action
            android:id="@+id/action_behavior_preferences_fragment_to_metadataList"
            app:destination="@id/metadata_list_fragment" />
    </fragment>

    <fragment
        android:id="@+id/metadata_list_fragment"
        android:name="org.phenoapps.intercross.fragments.metadata.MetadataListFragment"
        android:label="Metadata List">
        <action
            android:id="@+id/action_from_metadata_list_to_form"
            app:destination="@id/metadata_form_fragment" />
    </fragment>

    <fragment
        android:id="@+id/metadata_form_fragment"
        android:name="org.phenoapps.intercross.fragments.metadata.MetadataFormFragment"
        android:label="Metadata Form">
        <argument
            android:name="property"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/preferences_fragment"
        android:name="org.phenoapps.intercross.fragments.preferences.PreferencesFragment"
        android:label="@string/settings_label">

        <action android:id="@+id/action_from_preferences_fragment_to_profile_fragment"
            app:destination="@+id/profile_preference_fragment"
            app:launchSingleTop="true">
            <argument
