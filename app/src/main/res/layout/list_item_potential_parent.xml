<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />

        <variable
            name="title"
            type="String" />

        <variable
            name="observationUnitId"
            type="String" />

        <variable
            name="externalReference"
            type="String" />

        <variable
            name="parentType"
            type="String" />

        <variable
            name="additionalInfo"
            type="String" />

        <variable
            name="showAdditionalInfo"
            type="Boolean" />

        <variable
            name="additionalInfoToggleText"
            type="String" />

        <variable
            name="showRecentObservationIcon"
            type="Boolean" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/recentObservationStar"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/brapi_recent_observation_parent_icon_desc"
                android:visibility="@{showRecentObservationIcon ? View.VISIBLE : View.GONE}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_brapi_star_recent_parent_24"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/titleTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="@{title}"
                android:textColor="@color/card_meta_value"
                android:textSize="18sp"
                app:layout_constraintEnd_toStartOf="@id/recentObservationStar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Parent Unit 101" />

            <com.google.android.material.chip.Chip
                android:id="@+id/idChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clickable="false"
                android:focusable="false"
                android:text="@{observationUnitId}"
                app:chipIcon="@drawable/ic_badge_black_24dp"
                app:closeIconVisible="false"
                app:ensureMinTouchTargetSize="false"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titleTextView"
                tools:text="obs-unit-1001" />

            <com.google.android.material.chip.Chip
                android:id="@+id/parentTypeChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clickable="false"
                android:focusable="false"
                android:text="@{parentType}"
                app:closeIconVisible="false"
                app:ensureMinTouchTargetSize="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titleTextView"
                tools:text="FEMALE" />

            <TextView
                android:id="@+id/externalReferenceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/brapi_external_reference"
                android:textAllCaps="true"
                android:textColor="@color/card_meta_label"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/idChip" />

            <TextView
                android:id="@+id/externalReferenceValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@{externalReference}"
                android:textColor="@color/card_meta_value"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/externalReferenceLabel"
                tools:text="PARENT-REF-1" />

            <com.google.android.material.chip.Chip
                android:id="@+id/additionalInfoToggleChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@{additionalInfoToggleText}"
                app:chipIcon="@drawable/ic_about_info"
                app:closeIconVisible="false"
                app:ensureMinTouchTargetSize="false"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/externalReferenceValue"
                tools:text="Show Additional Info" />

            <TextView
                android:id="@+id/additionalInfoTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:text="@{additionalInfo}"
                android:textSize="12sp"
                android:visibility='@{showAdditionalInfo ? View.VISIBLE : View.GONE}'
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/additionalInfoToggleChip"
                tools:text="{ observationUnitName: Parent Unit 101 }" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>